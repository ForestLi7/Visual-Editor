# Visual Editor — nginx 反向代理示例
# Docker 同机部署: http://127.0.0.1:5174/visual-editor/
# 开发机反代:     http://127.0.0.1:5174/visual-editor/
# 路径须与 VE_BASE_PATH=/visual-editor/ 一致
#
# 将本文件 include 到现有测试域名的 server {} 中，或复制 location 段。

# --- 方式 A：子路径挂载（推荐，与打包默认 VE_BASE_PATH=/visual-editor/ 一致）---

location /visual-editor/ {
    proxy_pass http://127.0.0.1:5174/visual-editor/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # 导入 HTML / 上传可能较大
    client_max_body_size 32m;
    proxy_read_timeout 120s;
    proxy_send_timeout 120s;
}

# 若仍 403：多为 Vite 校验 Host，请升级编辑器并重启 dev（vite.config 已设 allowedHosts: true）
# 或临时：proxy_set_header Host 127.0.0.1:5174;

# iframe 预览页与 API 同域，无需额外 location（已包含在上面的前缀下）

# --- 方式 B：独立子域名根路径（VE_BASE_PATH=/）---
